<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Light"
             Name="Aseprite Frame Config Editor"
             x:Class="Ohko.Editor.App">

	<Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>

	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="About Aseprite Frame Config Editor" />
		</NativeMenu>
	</NativeMenu.Menu>

</Application>