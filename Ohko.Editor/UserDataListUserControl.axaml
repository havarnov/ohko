<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:Ohko.Editor"
             x:DataType="editor:UserDataListViewModel"
             x:Class="Ohko.Editor.UserDataListUserControl">

    <DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical">
            <Button Command="{Binding CreateNewUserDataCommand}">Add new</Button>
        </StackPanel>

        <ScrollViewer>
            <ListBox ItemsSource="{Binding EditorModel.UserDataModelsCurrentFrame}"
                     SelectedItem="{Binding EditorModel.SelectedUserDataModel, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Id}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </DockPanel>
</UserControl>
