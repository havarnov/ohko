<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editor="clr-namespace:Ohko.Editor"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="editor:UserDataViewModel"
             x:Class="Ohko.Editor.UserDataUserControl">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Color: "></TextBlock>
                <ColorPicker Color="{Binding EditorModel.SelectedUserDataModel.Color, Mode=TwoWay}">
                </ColorPicker>
            </StackPanel>

            <TextBox
                Grid.Row="1"
                IsEnabled="{Binding EditorModel.SelectedUserDataModel, Converter={x:Static ObjectConverters.IsNotNull}}"
                Text="{Binding EditorModel.SelectedUserDataModel.Value, Mode=TwoWay}"
                AcceptsReturn="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Watermark="User Data">
            </TextBox>
        </Grid>
</UserControl>
