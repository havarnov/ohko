<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editor="clr-namespace:Ohko.Editor"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="editor:HomeControl"
             x:Class="Ohko.Editor.HomeControl">

    <Grid
        RowDefinitions="Auto,*"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Button Grid.Row="0" Click="SelectFileButtonClickHandler">Select file...</Button>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentFiles}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <HyperlinkButton
                        Content="{Binding}"
                        Command="{Binding SelectRecentFileCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=editor:HomeControl}}"
                        CommandParameter="{Binding}">
                    </HyperlinkButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</UserControl>
